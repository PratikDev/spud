DISCORD_TOKEN=
DISCORD_CLIENT_ID=
GEMINI_MODEL_NAME=gemini-3.1-flash-lite
PORT=3000
PUBLIC_BASE_URL=http://localhost:3000

# Required — base64-encoded 32-byte key used to encrypt sensitive columns
# (webhook_secret, gemini_api_key) at rest. Generate with `openssl rand -base64 32`.
ENCRYPTION_KEY=

# Required — from your GitHub App's settings page. GITHUB_APP_SLUG is from its
# public page URL (github.com/apps/<slug>). GITHUB_APP_PRIVATE_KEY is the
# App's private key .pem, pasted as-is (quoted, real newlines and all).
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----
...
-----END RSA PRIVATE KEY-----"

# Optional — only needed to run against a real Turso database. Unset, db.ts
# falls back to a local SQLite file at DATABASE_PATH (defaults to spud.sqlite).
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
DATABASE_PATH=spud.sqlite

# Optional — minimum log level to emit (debug/info/warn/error). Defaults to
# "info" if unset. Use "debug" locally, leave unset (or "info") in production.
LOG_LEVEL=info

# Optional — logs ship to Grafana Cloud Loki only if all three are set.
# LOKI_HOST is the bare instance URL (no path), same as the Grafana data
# source's "Connection URL".
LOKI_HOST=
USER_ID=
GRAFANA_CLOUD_TOKEN=